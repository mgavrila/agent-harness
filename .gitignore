# secrets
.env
*.env
!.env.example

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# data and generated files (anchored for the same reason as /storage/ below: a bare
# `data/` would also hide any future src/.../data/ directory from git)
/data/
# Anchored: an unanchored `storage/` also matches source directories at any depth, which
# silently hid harness/core-tools/src/domain/storage/ from git. The file store this ignores
# is a repository-root directory; every deployed root is an absolute path outside the tree.
/storage/
.harness-storage/
*.sqlite
packs/*/synthetic/out/
evals/results/
# What release.yml packs into before it uploads: seven tarballs and the release body. Anchored
# for the same reason as /data/ above, and an untracked .tgz is one careless `git add` from
# being committed.
/release/

# os / editors
.DS_Store
.idea/
# Personal editor state stays out; the shared extension recommendations are committed.
.vscode/*
!.vscode/extensions.json

# superpowers scratch and worktrees
.superpowers/
.claude/worktrees/

# node
node_modules/
dist/
