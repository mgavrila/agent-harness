# Postgres (docker compose defaults)
DATABASE_URL=postgres://harness:harness@localhost:15432/harness
TEST_DATABASE_URL=postgres://harness:harness@localhost:15432/harness_test

# 32 random bytes, base64. Generate with: openssl rand -base64 32
HARNESS_ENCRYPTION_KEY=

# --- Where a client comes from ------------------------------------------------
# Required, with no default: a host that guessed would start and serve nobody.
#   files     one directory per client under HARNESS_CLIENTS_DIR
#   postgres  versioned rows in client_documents, written by the platform
HARNESS_CONFIG_SOURCE=files

# The directory holding one sub-directory per client, each with a client.yaml
# (or a blueprint.yaml and an overlay.yaml). A real client NEVER lives in this
# repository: a client is data, and adding one changes nothing here. Required
# when HARNESS_CONFIG_SOURCE=files.
# This is the HOST-side path. Compose bind-mounts it read-only at /srv/tenants
# inside the container and gives the container that path instead, so a relative
# value here is resolved against harness/compose/ and an absolute one is taken
# as it is. The default below is this repository's one fixture client, which is
# what a fresh checkout can start against and nothing else; point it at the
# deployment's own tenants directory, e.g. /srv/tenants.
HARNESS_CLIENTS_DIR=../../clients

# Which client this process serves.
#   set    a dedicated host: it serves that client and refuses an event for any
#          other, with an audit row naming both.
#   unset  a pooled host: the client is resolved per run, from the surface's own
#          tenant hint or the run API's x-harness-client header.
# Setting it to an empty value is a startup error, not a request for the default.
HARNESS_CLIENT=fixture

# --- Identity ---------------------------------------------------------------
# The stdio server's principal (the MCP inspector and the eval runner); the
# host uses HARNESS_HOST_PRINCIPAL. An id the client document's `identity`
# section declares. Defaults to `svc-local`, the local operator's service
# identity. An id the document does not declare is a startup error, and so is
# an empty value.
HARNESS_PRINCIPAL=svc-local

# Which identity plug-in resolves principals is the client document's
# `identityPlugin.kind`, not a variable.

# --- Host --------------------------------------------------------------------
# Which runtime plug-in owns the loop is the client document's `runtime`: a
# plug-in name the host turns into a package specifier, not a variable.

# The host's own service identity, declared in the client document's `identity`
# section: reconciliation runs as it. A playbook runs as the principal its own
# entry in the document's `playbooks` section names, never as this one. Must be
# a service.
#HARNESS_HOST_PRINCIPAL=svc-host

# Per-run ceilings the host hands the runtime. A run past any of them ends with an error the
# human sees; LiteLLM's daily budget is the other half of this.
#HARNESS_RUN_MAX_MODEL_CALLS=30
#HARNESS_RUN_MAX_TOOL_CALLS=60
#HARNESS_RUN_TIMEOUT_S=600

# How many prior turns of a thread the runtime is handed as history (also capped at 24,000
# characters). The runtime's own checkpoint carries the rest.
#HARNESS_HISTORY_MAX_MESSAGES=40

# --- Run API (spec 5.8) -------------------------------------------------------
# An HTTP way to open a run, stream its events, cancel it and read a thread back.
# It is OFF unless HARNESS_HOST_TOKEN is set: a control plane must not open a
# socket with no credential because a variable was missing. Generate one with:
#   openssl rand -hex 24
# Every route wants `Authorization: Bearer <this>`. Who a run acts as is still the
# identity plug-in's answer, from the `surface` and `userId` the request names.
#HARNESS_HOST_TOKEN=

# Interface the API binds. Loopback by default. Inside Compose it is 0.0.0.0 for
# the reason APPROVALS_HEALTH_BIND is: a container-loopback listener answers no
# published port. Exposure is the Compose port mapping, which is loopback-only.
#HARNESS_HOST_BIND=127.0.0.1

# Port the API listens on inside the process.
#HARNESS_HOST_PORT=8788

# Host-side port Compose publishes the API on (127.0.0.1:<this>:8788). Read by
# Compose only, never by the code. Change it if 8788 is taken on your machine.
#HARNESS_HOST_PUBLISHED_PORT=8788

# A caller of the API names a loaded surface and that surface's own user id, so
# declare the run API surface in the client document's `surfaces` section beside a
# messaging one, and give each caller an entry for it in the document's `identity`.

# --- Knowledge ----------------------------------------------------------------
# How wide an embedding vector this deployment stores. The column was created at
# this width by migration 0013 and cannot be changed in place: the harness reads
# the column at startup and refuses to start when the two disagree, so changing
# this means a new database. It is also the width asked of the `embed` route on
# every request, and a vector of any other width is refused.
#HARNESS_EMBED_DIMS=1024

# How long a parked approval stays actionable before it expires. 1..720 hours.
APPROVAL_TTL_HOURS=24

# Extraction confidence at or above which a field is 'extracted' rather than
# 'pending' human confirmation. 0..1.
# CONFIDENCE_THRESHOLD is optional; the default (0.85) is DEFAULT_CONFIDENCE_THRESHOLD in core-tools.
#CONFIDENCE_THRESHOLD=

# --- File store ---------------------------------------------------------------
# Root of the harness file store. Required, with no default: a deployment that
# has not said where files live must fail at startup rather than scatter
# provider documents into whatever directory happened to be the working
# directory. Ingested documents and their redacted text sidecars live under it;
# everything a human may receive is under <dir>/out. Nothing outside it can be
# ingested or released. Give an absolute path — a relative one is resolved
# against the process working directory, which is rarely what you meant.
# Gitignored when it is inside the repository.
HARNESS_STORAGE_DIR=/srv/harness-storage

# --- Files worker (@harness/files) --------------------------------------------
# The parsing worker's own two variables. It also reads HARNESS_STORAGE_DIR and
# nothing else: no key, no database URL, no provider credential. Compose sets
# both; on bare metal the defaults are a loopback listener on 8790.
#HARNESS_FILES_PORT=8790
#HARNESS_FILES_BIND=127.0.0.1

# Where core-tools sends documents to be parsed. Unset, core-tools parses in
# this process with the same binaries (see "Document pipeline prerequisites"
# in README.md). Compose sets it to the worker on the internal network.
#HARNESS_FILES_URL=http://127.0.0.1:8790

# Optional override for the directory holding the form templates and
# templates.json. Leave it unset and core-tools takes the forms directory from
# the first pack the client document's `packs` list names, so swapping the
# pack swaps the templates with it. Set it only for a deployment that keeps
# its templates outside the pack; a relative path is resolved against the
# working directory.
# When the first pack ships no templates directory — and when there is no pack
# at all — the storage directory stands in, because the tools that read this
# value belong to a pack.
#HARNESS_FORMS_DIR=./packs/healthcare/forms

# --- Model gateway (LiteLLM) -------------------------------------------------
# Shared secret between core-tools and the proxy. Generate with:
#   openssl rand -hex 24
# LiteLLM convention is an "sk-" prefix. Required: core-tools refuses to start
# without it, because every model call goes through the proxy.
LITELLM_MASTER_KEY=

# Where core-tools reaches the proxy. Loopback only; the proxy holds the keys.
# Inside Compose the services override this with http://litellm:4000.
HARNESS_GATEWAY_URL=http://127.0.0.1:4000
HARNESS_GATEWAY_TIMEOUT_MS=120000

# Runaway breaker: how many model calls one run may make before the harness
# refuses. LiteLLM's daily budget is the other half of this; a loop can exhaust
# a whole day's budget in a minute without a per-run limit.
HARNESS_GATEWAY_MAX_CALLS_PER_RUN=100

# Provider keys. Only the ones a client document's `routing` section refers to
# need a value. All three below are free tiers that MAY TRAIN ON YOUR PROMPTS; never
# point a client with real data at them.
#   Gemini   https://aistudio.google.com/apikey
#   Groq     https://console.groq.com/keys
#   OpenRouter https://openrouter.ai/keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Documents ---------------------------------------------------------------
# Send restricted identifiers (SSN, EIN, DEA) to the model. Leave off.
# Turning this on requires a BAA with the model provider (spec 4.4).
HARNESS_RESTRICTED_TO_MODEL=false

# --- Verification ------------------------------------------------------------
# Every boolean below is opt-in: `true` or `1` switches it on, and anything
# else — unset, empty, `false`, `0`, a typo — leaves it off. Default off, so a
# deployment that sets nothing makes no outbound calls.

# Look NPIs up in the public CMS NPPES registry. Sends the NPI only, which is a
# public identifier, and changes nothing. Off unless you set it; leave it unset
# to work fully offline.
VERIFY_NPPES_ENABLED=true
# Unset means the public CMS endpoint below; an empty value is a startup error,
# so a blanked-out line cannot quietly send lookups to the live registry.
NPPES_BASE_URL=https://npiregistry.cms.hhs.gov/api/
VERIFY_TIMEOUT_MS=15000

# State medical board checks. No board adapter exists yet, so verify_state_license
# reports "unsupported" either way; this flag exists so a client can declare intent.
VERIFY_STATE_LICENSE_ENABLED=false

# --- Messaging surfaces --------------------------------------------------------
# Which surfaces a client serves, and in what order, is its document's `surfaces`
# section; the first one the schema lists is the primary — where approval cards are
# posted — and the run API surface is always last because it cannot post an approval
# card. Decisions are accepted from whichever surface posted the card, and a staged
# effect may name any loaded one. An adapter a document names must also be in
# @harness/host's dependencies so pnpm can resolve it.
#
# The secrets below are still this deployment's, and a document's `surfaces` section
# refers to them by variable name.

# --- Slack adapter (@harness/surface-slack) ---
# ONE Slack app, in Socket Mode, with Interactivity on. Bot scopes: chat:write, app_mentions:read,
# channels:history, groups:history, im:history, im:read, im:write, mpim:history, users:read,
# files:read, files:write. Subscribe the app to the message.channels, message.groups, message.im,
# message.mpim and app_mention events. Invite the bot to the channels it should answer in.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Channel the host posts approval cards and released files into (a channel id, e.g. C0123456789).
SLACK_APPROVALS_CHANNEL=

# Who may decide an approval is not a surface setting any more: a decision is accepted only from
# a principal of level `lead` or above, resolved by the identity plug-in from the surface user id
# on the surface the card was posted on (the client document's `identity` section).

# --- Approvals app loops (seconds) ---
APPROVALS_POLL_SECONDS=5
EFFECTS_DISPATCH_SECONDS=5
RECONCILE_SECONDS=300
APPROVALS_HEALTH_PORT=8787
# Interface the health endpoint binds inside the container. Leave it at
# 0.0.0.0: a container-loopback listener answers neither the published host
# port nor a health check from another container on the network. Exposure is
# controlled by the Compose port mapping, which is loopback-only on the host.
# Set 127.0.0.1 only for a bare-metal run where the process itself is the
# boundary.
APPROVALS_HEALTH_BIND=0.0.0.0
# Host-side port for the approvals health endpoint published by Compose
# (127.0.0.1:<this>:8787). Change it if 8787 is already taken on your machine;
# the container always listens on 8787 regardless of this value.
APPROVALS_HEALTH_HOST_PORT=8787

# --- Evals -------------------------------------------------------------------
# Separate database: the runner truncates every table between cases.
EVALS_DATABASE_URL=postgres://harness:harness@localhost:15432/harness_evals

# Which model actually served each route on this run, as a JSON object of route
# to model identifier. It is recorded verbatim as the report's `serving_model`,
# so set it from the routing table the run really used: a score with no model
# behind it is not comparable to any other score.
EVALS_SERVING_MODEL={"extract":"gemini/gemini-3-flash-preview","judge":"groq/openai/gpt-oss-120b"}
