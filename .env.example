# Postgres (docker compose defaults)
DATABASE_URL=postgres://harness:harness@localhost:15432/harness
TEST_DATABASE_URL=postgres://harness:harness@localhost:15432/harness_test

# 32 random bytes, base64. Generate with: openssl rand -base64 32
HARNESS_ENCRYPTION_KEY=

# Which client instance this process serves (matches clients/<name>/).
# Defaults to `default` when unset. Setting it to an empty value is a startup
# error, not a request for the default.
HARNESS_CLIENT=demo-practice

# --- Identity ---------------------------------------------------------------
# The principal a core-tools process acts as: an id declared in
# clients/<HARNESS_CLIENT>/identity.yaml. Defaults to `svc-local`, the local
# operator's service identity, which is what the MCP inspector and the eval
# runner want; the Hermes and approvals containers set their own. An id the
# identity file does not declare is a startup error, and so is an empty value.
HARNESS_PRINCIPAL=svc-local

# Which identity plug-in resolves principals, as a package name loaded at
# startup. The static plug-in reads identity.yaml; a directory-backed one
# comes with the client that needs it.
#HARNESS_IDENTITY=@harness/identity-static

# Optional: where the static identity plug-in reads the principals from. Unset,
# it reads clients/<HARNESS_CLIENT>/identity.yaml. Set it only to point a
# bare-metal run at a file outside the client folder.
#HARNESS_IDENTITY_FILE=

# Optional: path to a policy.yaml overriding the default action-class table
HARNESS_POLICY_FILE=

# --- Packs ---------------------------------------------------------------------
# Which product areas this deployment serves, as a comma-separated list of pack
# package names. core-tools imports each one at startup and takes its document
# kinds, extraction manifest, form templates and skills from it. A pack named
# here must also be in @harness/core-tools' dependencies so pnpm can resolve it.
HARNESS_PACKS=@harness/pack-healthcare

# How long a parked approval stays actionable before it expires. 1..720 hours.
APPROVAL_TTL_HOURS=24

# Extraction confidence at or above which a field is 'extracted' rather than
# 'pending' human confirmation. 0..1.
# CONFIDENCE_THRESHOLD is optional; the default (0.85) is DEFAULT_CONFIDENCE_THRESHOLD in core-tools.
#CONFIDENCE_THRESHOLD=

# --- File store ---------------------------------------------------------------
# Root of the harness file store. Required, with no default: a deployment that
# has not said where files live must fail at startup rather than scatter
# provider documents into whatever directory happened to be the working
# directory. Ingested documents and their redacted text sidecars live under it;
# everything a human may receive is under <dir>/out. Nothing outside it can be
# ingested or released. Give an absolute path — a relative one is resolved
# against the process working directory, which is rarely what you meant.
# Gitignored when it is inside the repository.
HARNESS_STORAGE_DIR=/srv/harness-storage

# --- Files worker (@harness/files) --------------------------------------------
# The parsing worker's own two variables. It also reads HARNESS_STORAGE_DIR and
# nothing else: no key, no database URL, no provider credential. Compose sets
# both; on bare metal the defaults are a loopback listener on 8790.
#HARNESS_FILES_PORT=8790
#HARNESS_FILES_BIND=127.0.0.1

# Where core-tools sends documents to be parsed. Unset, core-tools parses in
# this process with the same binaries (see "Document pipeline prerequisites"
# in README.md). Compose sets it to the worker on the internal network.
#HARNESS_FILES_URL=http://127.0.0.1:8790

# Optional override for the directory holding the form templates and
# templates.json. Leave it unset and core-tools takes the forms directory from
# the first pack named in HARNESS_PACKS, so swapping the pack swaps the
# templates with it. Set it only for a deployment that keeps its templates
# outside the pack; a relative path is resolved against the working directory.
#HARNESS_FORMS_DIR=./packs/healthcare/forms

# --- Model gateway (LiteLLM) -------------------------------------------------
# Shared secret between core-tools and the proxy. Generate with:
#   openssl rand -hex 24
# LiteLLM convention is an "sk-" prefix. Required: core-tools refuses to start
# without it, because every model call goes through the proxy.
LITELLM_MASTER_KEY=

# Where core-tools reaches the proxy. Loopback only; the proxy holds the keys.
# Inside Compose the services override this with http://litellm:4000.
HARNESS_GATEWAY_URL=http://127.0.0.1:4000
HARNESS_GATEWAY_TIMEOUT_MS=120000

# Runaway breaker: how many model calls one run may make before the harness
# refuses. LiteLLM's daily budget is the other half of this; a loop can exhaust
# a whole day's budget in a minute without a per-run limit.
HARNESS_GATEWAY_MAX_CALLS_PER_RUN=100

# Provider keys. Only the ones your clients/<name>/routing.yaml refers to need
# a value. All three below are free tiers that MAY TRAIN ON YOUR PROMPTS; never
# point a client with real data at them.
#   Gemini   https://aistudio.google.com/apikey
#   Groq     https://console.groq.com/keys
#   OpenRouter https://openrouter.ai/keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Documents ---------------------------------------------------------------
# Send restricted identifiers (SSN, EIN, DEA) to the model. Leave off.
# Turning this on requires a BAA with the model provider (spec 4.4).
HARNESS_RESTRICTED_TO_MODEL=false

# --- Verification ------------------------------------------------------------
# Every boolean below is opt-in: `true` or `1` switches it on, and anything
# else — unset, empty, `false`, `0`, a typo — leaves it off. Default off, so a
# deployment that sets nothing makes no outbound calls.

# Look NPIs up in the public CMS NPPES registry. Sends the NPI only, which is a
# public identifier, and changes nothing. Off unless you set it; leave it unset
# to work fully offline.
VERIFY_NPPES_ENABLED=true
# Unset means the public CMS endpoint below; an empty value is a startup error,
# so a blanked-out line cannot quietly send lookups to the live registry.
NPPES_BASE_URL=https://npiregistry.cms.hhs.gov/api/
VERIFY_TIMEOUT_MS=15000

# State medical board checks. No board adapter exists yet, so verify_state_license
# reports "unsupported" either way; this flag exists so a client can declare intent.
VERIFY_STATE_LICENSE_ENABLED=false

# --- Messaging surfaces --------------------------------------------------------
# Which messaging surfaces the approvals host serves, as a comma-separated list of
# adapter package names. The FIRST one is the primary: it is where approval cards
# are posted. Decisions are accepted from whichever surface posted the card, and a
# staged effect may name any loaded one. An adapter named here must also be in
# @harness/approvals' dependencies so pnpm can resolve it.
#
# Required: the host has no default and fails at startup naming this variable if it
# is unset or empty, because where an approval card is posted is a deployment's
# decision and not the code's. Under Compose the service supplies this value.
HARNESS_SURFACES=@harness/surface-slack

# --- Slack adapter (@harness/surface-slack) ---
# TWO Slack apps are required, not one. Slack delivers each Socket Mode event
# to exactly one of an app's open connections, so a single app shared by the
# Hermes gateway and the approvals app loses about half of every button click
# and modal submission. Enable Socket Mode on both.
#
# App 1 — Hermes's gateway. Bot scopes: chat:write, app_mentions:read,
# channels:history, groups:history, im:history, im:read, im:write,
# mpim:history, users:read, files:read, files:write
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
#
# App 2 — the approvals app. Bot scopes: chat:write, users:read, files:write.
# Interactivity must be on so the approval buttons and the note modal work.
# Only the approvals container ever sees these two.
APPROVALS_SLACK_BOT_TOKEN=
APPROVALS_SLACK_APP_TOKEN=
# Channel the approvals app posts cards and files into (a channel id, e.g. C0123456789).
# Invite app 2's bot to it.
SLACK_APPROVALS_CHANNEL=
# Hermes' own Slack gateway settings.
SLACK_HOME_CHANNEL=
SLACK_HOME_CHANNEL_NAME=

# Who may decide an approval is not a surface setting any more: a decision is accepted only from
# a principal of level `lead` or above, resolved by the identity plug-in from the surface user id
# on the surface the card was posted on (clients/<name>/identity.yaml).

# --- Approvals app loops (seconds) ---
APPROVALS_POLL_SECONDS=5
EFFECTS_DISPATCH_SECONDS=5
RECONCILE_SECONDS=300
APPROVALS_HEALTH_PORT=8787
# Interface the health endpoint binds inside the container. Leave it at
# 0.0.0.0: a container-loopback listener answers neither the published host
# port nor http://approvals:8787 from Hermes. Exposure is controlled by the
# Compose port mapping, which is loopback-only on the host. Set 127.0.0.1 only
# for a bare-metal run where the process itself is the boundary.
APPROVALS_HEALTH_BIND=0.0.0.0
# Host-side port for the approvals health endpoint published by Compose
# (127.0.0.1:<this>:8787). Change it if 8787 is already taken on your machine;
# the container always listens on 8787 regardless of this value.
APPROVALS_HEALTH_HOST_PORT=8787

# --- Hermes container -------------------------------------------------------
# Match the host user that owns the Hermes data volume.
HERMES_UID=1000
HERMES_GID=1000

# --- Evals -------------------------------------------------------------------
# Separate database: the runner truncates every table between cases.
EVALS_DATABASE_URL=postgres://harness:harness@localhost:15432/harness_evals

# Which model actually served each route on this run, as a JSON object of route
# to model identifier. It is recorded verbatim as the report's `serving_model`,
# so set it from the routing table the run really used: a score with no model
# behind it is not comparable to any other score.
EVALS_SERVING_MODEL={"extract":"gemini/gemini-3-flash-preview","judge":"groq/openai/gpt-oss-120b"}
