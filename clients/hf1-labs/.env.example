# Environment for the hf1-labs deployment.
# Copy to the repository root as `.env`; every service reads it from there.
#   cp clients/hf1-labs/.env.example .env

# --- Identity ---------------------------------------------------------------
# The principals themselves are in identity.yaml beside this file.
HARNESS_CLIENT=hf1-labs
# The stdio server's principal for a bare-metal run; see identity.yaml. The containers set their own.
HARNESS_PRINCIPAL=svc-local
HARNESS_POLICY_FILE=./clients/hf1-labs/policy.yaml
# Which packs this client serves, comma-separated package names. The first one
# answers for the extraction manifest and the forms directory.
#
# AMA needs none of them: she works through the kernel's own tools — memory,
# knowledge, playbooks, approvals, files. An empty value means "no pack" (an
# unset one would fall back to the kernel's default pack): the catalogue is the
# kernel's tools, and the two document tools that need a declared document kind
# are not published. To give AMA a domain later, name a pack here.
HARNESS_PACKS=

# --- Data -------------------------------------------------------------------
DATABASE_URL=postgres://harness:harness@localhost:15432/harness
TEST_DATABASE_URL=postgres://harness:harness@localhost:15432/harness_test
# 32 random bytes, base64: openssl rand -base64 32
HARNESS_ENCRYPTION_KEY=
# One storage directory per client instance; never shared across clients.
HARNESS_STORAGE_DIR=/srv/harness-storage   # absolute; inside the containers this is the storage volume

# --- Behaviour --------------------------------------------------------------
APPROVAL_TTL_HOURS=24
# CONFIDENCE_THRESHOLD is optional; the default (0.85) is DEFAULT_CONFIDENCE_THRESHOLD in core-tools.
#CONFIDENCE_THRESHOLD=

# --- Messaging surfaces -----------------------------------------------------
# Comma-separated adapter package names; the first is where approval cards go.
# Slack is where the team talks to AMA; the HTTP surface is the run API, and it
# goes second because it could not post an approval card if it were asked to.
# Set it to @harness/surface-memory to run the host with no Slack workspace.
HARNESS_SURFACES=@harness/surface-slack,@harness/surface-http

# --- Slack adapter (@harness/surface-slack) ---
# ONE Slack app, in Socket Mode, with Interactivity on. Bot scopes: chat:write, app_mentions:read,
# channels:history, groups:history, im:history, im:read, im:write, mpim:history, users:read,
# files:read, files:write. Subscribe the app to the message.channels, message.groups, message.im,
# message.mpim and app_mention events. Invite the bot to the channels it should answer in.
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-
# Channel the host posts approval cards and released files into.
SLACK_APPROVALS_CHANNEL=
# Who may decide an approval is not a setting here any more: it is whoever identity.yaml lists
# at level `lead` or above, resolved from the Slack user id that pressed the button.

# --- Run API (@harness/surface-http) ---
# With no token there is no listener: nothing is bound, and the host's
# `listening` line says runApi=off. See docs/runbook.md, "The run API".
# A long random string: openssl rand -hex 32
HARNESS_HOST_TOKEN=
HARNESS_HOST_BIND=127.0.0.1
HARNESS_HOST_PORT=8788

# --- Approvals app loops ----------------------------------------------------
APPROVALS_POLL_SECONDS=5
EFFECTS_DISPATCH_SECONDS=5
RECONCILE_SECONDS=300
APPROVALS_HEALTH_PORT=8787
# Interface the health endpoint binds inside the container. Leave it at
# 0.0.0.0: a container-loopback listener answers neither the published host
# port nor a health check from another container on the network. Exposure is
# controlled by the Compose port mapping, which is loopback-only on the host.
# Set 127.0.0.1 only for a bare-metal run where the process itself is the
# boundary.
APPROVALS_HEALTH_BIND=0.0.0.0
# Host-side port for the approvals health endpoint published by Compose
# (127.0.0.1:<this>:8787). Change it if 8787 is already taken on your machine;
# the container always listens on 8787 regardless of this value.
APPROVALS_HEALTH_HOST_PORT=8787

# --- Model gateway (Plan 2) -------------------------------------------------
LITELLM_MASTER_KEY=
# At least one provider key; the gateway starts without one but every model call fails.
GEMINI_API_KEY=
