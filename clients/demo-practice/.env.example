# Environment for the demo-practice deployment.
# Copy to the repository root as `.env`; every service reads it from there.
#   cp clients/demo-practice/.env.example .env

# --- Identity ---------------------------------------------------------------
HARNESS_CLIENT=demo-practice
CORE_TOOLS_CALLER=hermes
HARNESS_POLICY_FILE=./clients/demo-practice/policy.yaml
HARNESS_FORMS_DIR=./packs/healthcare/forms

# --- Data -------------------------------------------------------------------
DATABASE_URL=postgres://harness:harness@localhost:15432/harness
TEST_DATABASE_URL=postgres://harness:harness@localhost:15432/harness_test
# 32 random bytes, base64: openssl rand -base64 32
HARNESS_ENCRYPTION_KEY=
# One storage directory per client instance; never shared across clients.
HARNESS_STORAGE_DIR=/srv/harness-storage   # absolute; inside the containers this is the storage volume

# --- Behaviour --------------------------------------------------------------
APPROVAL_TTL_HOURS=24
CONFIDENCE_THRESHOLD=0.85

# --- Slack ------------------------------------------------------------------
# TWO Slack apps are required, not one. Slack delivers each Socket Mode event
# to exactly one of an app's open connections, so a single app shared by Hermes
# and the approvals app loses about half of every button click and modal
# submission, and the approval just stays pending. Enable Socket Mode on both.
#
# App 1 — Hermes's gateway. Bot scopes: chat:write, app_mentions:read,
# channels:history, groups:history, im:history, im:read, im:write,
# mpim:history, users:read, files:read, files:write
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-
#
# App 2 — the approvals app. Bot scopes: chat:write, users:read, files:write.
# Interactivity must be on so the approval buttons and the note modal work.
# Compose gives these to the approvals container only; Hermes never sees them.
APPROVALS_SLACK_BOT_TOKEN=xoxb-
APPROVALS_SLACK_APP_TOKEN=xapp-
# Invite app 2's bot to this channel.
SLACK_APPROVALS_CHANNEL=
SLACK_HOME_CHANNEL=
SLACK_HOME_CHANNEL_NAME=credentialing
# Required: comma-separated Slack user ids allowed to decide approvals. Left
# empty, the approvals app refuses every decision.
SLACK_ALLOWED_USERS=

# --- Approvals app loops ----------------------------------------------------
APPROVALS_POLL_SECONDS=5
EFFECTS_DISPATCH_SECONDS=5
RECONCILE_SECONDS=300
APPROVALS_HEALTH_PORT=8787
# Interface the health endpoint binds inside the container. Leave it at
# 0.0.0.0: a container-loopback listener answers neither the published host
# port nor http://approvals:8787 from Hermes. Exposure is controlled by the
# Compose port mapping, which is loopback-only on the host. Set 127.0.0.1 only
# for a bare-metal run where the process itself is the boundary.
APPROVALS_HEALTH_BIND=0.0.0.0
# Host-side port for the approvals health endpoint published by Compose
# (127.0.0.1:<this>:8787). Change it if 8787 is already taken on your machine;
# the container always listens on 8787 regardless of this value.
APPROVALS_HEALTH_HOST_PORT=8787

# --- Model gateway (Plan 2) -------------------------------------------------
LITELLM_MASTER_KEY=
# At least one provider key; the gateway starts without one but every model call fails.
GEMINI_API_KEY=

# --- Hermes container -------------------------------------------------------
# Match the host user that owns the Hermes data volume.
HERMES_UID=1000
HERMES_GID=1000
